# Public deploy-time parameter. The address must be verified in SendGrid.
PASSWORD_RESET_FROM_EMAIL=verified-sender@example.com
# IANA timezone used to interpret every booking date/time.
SALON_TIME_ZONE=Asia/Manila
# External Spark-compatible worker only. Keep both values server-side.
FIREBASE_DATABASE_URL=https://your-project-default-rtdb.region.firebasedatabase.app
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project"}
SENDGRID_API_KEY=server-secret-only
