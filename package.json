{
  "name": "nail-booking-system",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "test:emulator": "firebase emulators:exec --project demo-luxe-availability --only database \"node --test --test-timeout=30000 --test-concurrency=1 tests/spark/*.test.js\"",
    "test:auth-emulator": "firebase emulators:exec --project demo-luxe-availability --only auth,database \"node --test --test-concurrency=1 tests/emulator-auth/login.test.js\"",
    "sync-auth": "node scripts/syncAuthToRealtimeDatabase.js",
    "test:mobile": "firebase emulators:exec --project demo-luxe-availability --only auth,database \"node tests/mobile/booking.mjs\"",
    "test:managed-emulator": "firebase emulators:exec --config firebase.managed.json --project demo-luxe-availability --only functions,auth,database \"node --test --test-concurrency=1 tests/emulator-auth/*.test.js tests/emulator/*.test.js\"",
    "rules:generate": "node scripts/buildSparkRules.mjs",
    "test:spark-app": "firebase emulators:exec --project demo-luxe-availability --only auth,database \"node --test --test-timeout=30000 --test-concurrency=1 tests/spark-app/*.test.js\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.2",
    "firebase": "^12.15.0",
    "lucide-react": "^1.23.0",
    "ogl": "^1.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "firebase-admin": "13.10.0",
    "vite": "^8.1.3"
  }
}
